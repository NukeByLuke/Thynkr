# Production Environment Variables for docker-compose.prod.yml
# Copy this to `.env` on your VPS and fill in secure values.

# --- Database (Postgres) ---
POSTGRES_USER=thynkr
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=thynkr_db

# --- JWT Secrets ---
# Generate strong random strings. Do NOT reuse dev values.
JWT_ACCESS_SECRET=replace_with_random_64_chars
JWT_REFRESH_SECRET=replace_with_random_64_chars

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=price_test_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_test_pro_yearly
STRIPE_PRICE_PREMIUM_MONTHLY=price_test_premium_monthly
STRIPE_PRICE_PREMIUM_YEARLY=price_test_premium_yearly

# --- OpenAI (optional; required only if enabling AI features) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frontend URL (optional; used by backend in links/emails) ---
# Set this to your public site URL after DNS is configured (e.g., https://app.example.com)
FRONTEND_URL=http://your-server-ip
