{
  "name": "thynkr-membership",
  "version": "1.0.0",
  "description": "Full-stack membership platform with React, TypeScript, Fastify, and Stripe",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "test": "pnpm --filter backend test && pnpm --filter frontend test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "lint": "pnpm --filter backend lint && pnpm --filter frontend lint",
    "typecheck": "pnpm --filter backend exec tsc --noEmit && pnpm --filter frontend exec tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "feature:new": "powershell -ExecutionPolicy Bypass -File ./scripts/new-feature.ps1",
    "feature:merge": "powershell -ExecutionPolicy Bypass -File ./scripts/merge-feature.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "pnpm exec prettier --write",
      "pnpm --filter frontend exec eslint --fix"
    ],
    "backend/**/*.{ts,js}": [
      "pnpm exec prettier --write",
      "pnpm --filter backend exec eslint --fix"
    ],
    "*.{json,md}": [
      "pnpm exec prettier --write"
    ]
  }
}
