# =============================================================================
# Thynkr Docker Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Most values have safe defaults for development

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://thynkr:thynkr_dev_password@postgres:5432/thynkr_db"
POSTGRES_USER="thynkr"
POSTGRES_PASSWORD="thynkr_dev_password"
POSTGRES_DB="thynkr_db"

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL="redis://redis:6379"

# =============================================================================
# JWT SECRETS
# =============================================================================
# Generate secure keys with: openssl rand -base64 32
JWT_ACCESS_SECRET="your-access-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"

# =============================================================================
# SERVER
# =============================================================================
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5175"

# =============================================================================
# AI SERVICES
# =============================================================================
# OpenAI (Required for core AI features)
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini (Optional - for additional AI features)
# Leave empty or remove if not using Gemini
GEMINI_API_KEY=""

# =============================================================================
# STRIPE (Optional - only needed for payment testing)
# =============================================================================
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_STANDARD_MONTHLY="price_test_standard_monthly"
STRIPE_PRICE_STANDARD_YEARLY="price_test_standard_yearly"
STRIPE_PRICE_PREMIUM_MONTHLY="price_test_premium_monthly"
STRIPE_PRICE_PREMIUM_YEARLY="price_test_premium_yearly"

# Vite Stripe Public Keys (for frontend)
VITE_STRIPE_PRICE_STANDARD_MONTHLY="price_test_standard_monthly"
VITE_STRIPE_PRICE_STANDARD_YEARLY="price_test_standard_yearly"
VITE_STRIPE_PRICE_PREMIUM_MONTHLY="price_test_premium_monthly"
VITE_STRIPE_PRICE_PREMIUM_YEARLY="price_test_premium_yearly"

# =============================================================================
# OAUTH (Optional)
# =============================================================================
# Google OAuth - Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# API URL
# =============================================================================
VITE_API_URL="http://localhost:3003/api"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_EMAIL_VERIFICATION="false"
ENABLE_ANALYTICS="false"

# =============================================================================
# NOTES
# =============================================================================
# - GEMINI_API_KEY is optional - app works fine with just OpenAI
# - Stripe keys are optional - only needed for payment testing
# - To enable Stripe CLI webhook forwarding, use:
#   docker-compose --profile stripe up
# - Default ports:
#   * Frontend: 5175
#   * Backend: 3003
#   * PostgreSQL: 5435
#   * Redis: 6380
